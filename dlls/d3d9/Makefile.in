	d3d9_main.c \
	device.c \
	directx.c \
	query.c \
	shader.c \
	stateblock.c \
	surface.c \
	swapchain.c \
	texture.c \
	version.rc \
	vertexdeclaration.c \
	volume.c

i386_LTO_SKIP_SRC = device.c
x86_64_LTO_SKIP_SRC = device.c
